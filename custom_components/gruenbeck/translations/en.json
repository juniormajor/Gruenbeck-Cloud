{
  "config": {
    "step": {
      "user": {
        "title": "Grünbeck",
        "description": "An existing setup of the integration \"Grünbeck Cloud\" (gruenbeck_cloud) was found.",
        "menu_options": {
          "legacy": "Take over existing setup (keeps entity ids and history)",
          "credentials": "Set up with new credentials"
        }
      },
      "credentials": {
        "title": "Grünbeck account",
        "data": {
          "username": "Email",
          "password": "Password"
        },
        "data_description": {
          "username": "Email address of your Grünbeck myProduct account.",
          "password": "Password of your Grünbeck myProduct account."
        }
      },
      "legacy": {
        "title": "Take over Grünbeck Cloud",
        "description": "The stored account {username} is used. The existing \"Grünbeck Cloud\" entry is removed and its entities are recreated under the same entity ids, so history, statistics, dashboards and automations keep working. Remove the old integration from HACS afterwards."
      },
      "reauth_confirm": {
        "title": "Re-enter password",
        "description": "The Grünbeck cloud rejected the password of {username}.",
        "data": {
          "password": "Password"
        }
      },
      "reconfigure": {
        "title": "Change credentials",
        "data": {
          "username": "Email",
          "password": "Password"
        },
        "data_description": {
          "username": "Email address of your Grünbeck myProduct account.",
          "password": "Password of your Grünbeck myProduct account."
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid email or password",
      "cannot_connect": "Cannot reach the Grünbeck cloud",
      "no_devices": "No softliQ device found in this account",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This account is already configured",
